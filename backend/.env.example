# Danh sách broker bật, cách nhau bằng dấu phẩy: demo, tcbs, dnse
BROKERS=demo

# Bảo vệ API (tuỳ chọn). Nếu đặt, mọi request phải có header X-App-Token
APP_ACCESS_TOKEN=

# Thư mục lưu SQLite, token phiên
DATA_DIR=data

# --- TCBS iFlash OpenAPI (TCInvest > Tiện ích > iFlash Open API) ---
TCBS_API_KEY=
TCBS_CUSTODY_CODE=
TCBS_BASE_URL=https://openapi.tcbs.com.vn

# --- DNSE LightSpeed API (Entrade X > LightSpeed API) ---
DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_API_VERSION=2026-07-23
